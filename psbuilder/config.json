{
  "verticals": [
    {
      "id": "wxcc",
      "name": "Webex Contact Centre",
      "note": "Available",
      "enabled": true,
      "phases": [
        "Kickoff",
        "Design",
        "Staging",
        "Implementation",
        "Project Completion & Handover"
      ],
      "locations": [
        "Office",
        "Client Site"
      ],
      "columns": [
        {
          "header": "Phase",
          "from": "phase"
        },
        {
          "header": "Skill Required",
          "constant": "Collaboration"
        },
        {
          "header": "Task Type",
          "constant": "ArchiTech Activity"
        },
        {
          "header": "Description",
          "from": "description"
        }
      ],
      "questions": [
        {
          "id": "engagement-type",
          "type": "choice",
          "display": "cards",
          "label": "Engagement Type",
          "options": [
            {
              "id": "new",
              "label": "New / Greenfield",
              "note": "Brand-new WxCC deployment, nothing to migrate off."
            },
            {
              "id": "migration",
              "label": "Migration",
              "note": "Customer is moving off another contact centre platform onto WxCC."
            }
          ]
        },
        {
          "id": "scope",
          "type": "choice",
          "display": "cards",
          "label": "Engagement Scope",
          "options": [
            {
              "id": "dfd",
              "label": "Digital Front Door",
              "note": "Core CC plus an AI Agent, AI Assistant/CRM integration and omnichannel layer."
            },
            {
              "id": "standard",
              "label": "Standard Contact Centre",
              "note": "Core routing/IVR/queue/agent config only. No AI or digital layer."
            }
          ]
        },
        {
          "id": "workshops",
          "type": "number",
          "label": "How many discovery workshops do you need?",
          "help": "Covers agent experience mapping, knowledge scripting, use-case gathering, CRM field mapping, omnichannel scope.",
          "min": 0,
          "max": 6,
          "default": 4
        },
        {
          "id": "staging-channels",
          "type": "checklist",
          "label": "Which channels need environment staging / provisioning?",
          "help": "Drives the Staging phase task list.",
          "options": [
            {
              "id": "sms",
              "label": "SMS asset provisioning"
            },
            {
              "id": "webexconnect",
              "label": "Webex Connect account/asset setup"
            },
            {
              "id": "facebook",
              "label": "Facebook Business Manager / Meta setup"
            },
            {
              "id": "instagram",
              "label": "Instagram DM custom channel setup"
            },
            {
              "id": "email",
              "label": "Email channel asset setup + mailbox routing"
            },
            {
              "id": "crm",
              "label": "CRM environment access confirmed",
              "showWhen": {
                "question": "scope",
                "is": "dfd"
              }
            }
          ]
        },
        {
          "id": "agent-domains",
          "type": "number",
          "label": "How many AI Agent bots / knowledge domains need to be built?",
          "help": "e.g. billing enquiries, product support, appointment booking — one domain per distinct topic area. Set to 0 to skip AI Agent entirely.",
          "showWhen": {
            "question": "scope",
            "is": "dfd"
          },
          "min": 0,
          "max": 6,
          "default": 2
        },
        {
          "id": "ai-assistant",
          "type": "yesno",
          "label": "Include AI Assistant + CRM integration for agents?",
          "help": "Screen-pop, transcription/summarisation, suggested responses, wrap-up automation, write-back to CRM. CRM platform is whatever the customer runs (Dynamics, Salesforce, ServiceNow, etc).",
          "showWhen": {
            "question": "scope",
            "is": "dfd"
          },
          "default": true
        },
        {
          "id": "omni-channels",
          "type": "checklist",
          "label": "Which omnichannel channels are in scope for build?",
          "help": "Each selected channel adds its build + integration task. Selecting any channel also adds an OmniChannel testing pass.",
          "showWhen": {
            "question": "scope",
            "is": "dfd"
          },
          "options": [
            {
              "id": "webchat",
              "label": "Web chat widget (branding, pre-chat form, reason codes)",
              "default": true
            },
            {
              "id": "sms-flow",
              "label": "SMS flow configuration",
              "default": true
            },
            {
              "id": "email-routing",
              "label": "Email routing and triage configuration",
              "default": true
            },
            {
              "id": "fb-messenger",
              "label": "Facebook Messenger integration and testing"
            },
            {
              "id": "instagram-dm",
              "label": "Instagram DM custom channel integration and testing"
            },
            {
              "id": "qb-api",
              "label": "Quick Button integration — external SMS sender API"
            },
            {
              "id": "qb-desktop",
              "label": "Quick Button integration — external SMS agent desktop"
            }
          ]
        },
        {
          "id": "reporting",
          "type": "checklist",
          "label": "Which reporting / analytics components are needed?",
          "help": "Optional on every engagement type.",
          "options": [
            {
              "id": "topic-analytics",
              "label": "Topic analytics configuration"
            },
            {
              "id": "analyzer-dashboard",
              "label": "Analyzer dashboard setup"
